DATABASE_URL=sqlite:///./b2b_ecommerce.db
SECRET_KEY=replace-with-a-long-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=

# Neo4j Aura example: neo4j+s://xxxxxxxx.databases.neo4j.io
# Local example: neo4j://localhost:7687
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_SYNC_ON_ASK=true

# The assistant still has a local fallback without this key.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.5

# Optional MCP-compatible integration switches. Keep disabled until the
# corresponding trusted server/adapter and credentials are configured.
MCP_FILESYSTEM_ENABLED=false
MCP_GITHUB_ENABLED=false
MCP_SEARCH_ENABLED=false
MCP_FETCH_ENABLED=false
MCP_PLAYWRIGHT_ENABLED=false
MCP_DATABASE_ENABLED=false
MCP_EMAIL_ENABLED=false
